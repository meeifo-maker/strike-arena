{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren() || data.exists()",
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['x', 'z', 'yaw', 'hp', 'alive', 'team'])"
          }
        }
      }
    }
  }
}